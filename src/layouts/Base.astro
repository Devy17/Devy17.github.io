---
const { title = 'Devy.hist', description = 'Devy.hist' } = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><title>{title}</title></head><body><main><nav aria-label="Main navigation"><a class="brand" href="/">Devy.hist</a><span class="links"><a href="/briefings/">Briefings</a><a href="/articles/">Articles</a><a href="/series/">Series</a><a href="/history/">History</a><a href="https://github.com/Devy17">GitHub</a></span></nav><slot /><footer>© 2026 Devy</footer></main></body></html>
<style is:global>
:root{--ink:#171717;--muted:#737373;--line:#e5e5e5;--paper:#fafaf9}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:760px;min-height:100vh;margin:0 auto;padding:28px 24px 48px;display:flex;flex-direction:column}nav{display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:14px}a{color:inherit;text-decoration:none}.brand{font-weight:700;letter-spacing:-.04em;white-space:nowrap}.links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:14px;color:var(--muted);font-size:13px}.links a:hover,.list-item:hover h2{color:var(--ink)}footer{margin-top:auto;padding-top:64px;color:var(--muted);font-size:12px}.page-head{padding:104px 0 56px}.eyebrow{margin:0 0 16px;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}h1{margin:0;font-size:clamp(52px,9vw,80px);line-height:1;letter-spacing:-.08em}.intro{max-width:520px;margin:20px 0 0;color:var(--muted);font-size:16px;line-height:1.65}.entry-list{border-top:1px solid var(--line)}.list-item{display:block;padding:24px 0;border-bottom:1px solid var(--line)}.list-meta{margin:0 0 9px;color:var(--muted);font-size:12px}h2{margin:0;font-size:22px;letter-spacing:-.045em;transition:color .15s}.list-description{margin:9px 0 0;color:var(--muted);font-size:14px;line-height:1.55}.empty{padding:32px 0;color:var(--muted);border-top:1px solid var(--line)}article.post{max-width:640px;padding:92px 0 32px}.post h1{font-size:clamp(40px,7vw,68px)}.post-meta{margin:20px 0 40px;color:var(--muted);font-size:13px}.prose{font-size:17px;line-height:1.8}.prose h2{margin:42px 0 14px;font-size:24px}.prose p,.prose ul{margin:0 0 20px}.prose code{padding:.15em .35em;border-radius:4px;background:#eeeeec;font-size:.88em}@media(max-width:650px){main{padding:22px 20px 36px}nav{align-items:flex-start}.links{gap:10px}.page-head{padding:82px 0 46px}}
</style>
