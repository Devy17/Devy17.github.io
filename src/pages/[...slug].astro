---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const date = (value: Date) => value.toLocaleDateString('en',{year:'numeric',month:'short',day:'numeric'});
const tagClass = (tag: string) => 'tag-' + ([...tag].reduce((sum, char) => sum + char.charCodeAt(0), 0) % 5);
export async function getStaticPaths() {
  const entries = (await getCollection('entries')).filter((entry) => !entry.data.draft);
  const articles = entries.filter((entry) => entry.data.kind === 'article').sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
  const history = entries.filter((entry) => entry.data.kind === 'history').sort((a,b) => a.data.pubDate.valueOf()-b.data.pubDate.valueOf());
  return [
    { params: { slug: 'articles' }, props: { mode: 'articles', entries: articles } },
    { params: { slug: 'history' }, props: { mode: 'history', entries: history } },
    ...articles.map((entry) => ({ params: { slug: `articles/${entry.id}` }, props: { mode: 'post', entry } })),
    ...history.map((entry) => ({ params: { slug: `history/${entry.id}` }, props: { mode: 'post', entry } }))
  ];
}
const props: any = Astro.props;
let Content: any; if (props.mode === 'post') ({ Content } = await render(props.entry));
---
{props.mode === 'articles' && <Base title="Articles · Devy.hist" description="Personal technical notes and articles."><header class="page-head"><p class="eyebrow">Articles</p><h1>Notes to keep.</h1><p class="intro">Technical notes, experiments, and work worth writing down.</p></header><section class="article-search" aria-label="Article search"><input id="article-query" class="search-input" type="search" placeholder="Search titles, descriptions, or tags" autocomplete="off" /><div class="filter-head"><span>Tags</span><button class="clear-filter" id="clear-filters" type="button" hidden>Clear</button></div><div class="tag-row tag-filters">{[...new Set(props.entries.flatMap((entry: any) => entry.data.tags))].sort().map((tag: string) => <button class={`tag tag-filter ${tagClass(tag)}`} type="button" data-filter-tag={tag}>{tag}</button>)}</div></section><p id="result-count" class="result-count"></p><div class="entry-list" id="article-list">{props.entries.map((entry: any) => <article class="list-item article-item" data-entry data-search={[entry.data.title, entry.data.description, ...entry.data.tags].join(' ').toLowerCase()} data-tags={entry.data.tags.map((tag: string) => tag.toLowerCase()).join('|')}><a href={`/articles/${entry.id}/`}><p class="list-meta">{date(entry.data.pubDate)}</p><h2>{entry.data.title}</h2><p class="list-description">{entry.data.description}</p></a><div class="tag-row">{entry.data.tags.map((tag: string) => <button class={`tag tag-filter ${tagClass(tag)}`} type="button" data-filter-tag={tag}>{tag}</button>)}</div></article>)}</div><p id="no-results" class="empty" hidden>No articles match this filter.</p><script>
  const input = document.querySelector('#article-query');
  const entries = [...document.querySelectorAll('[data-entry]')];
  const filters = [...document.querySelectorAll('[data-filter-tag]')];
  const activeTags = new Set();
  const clear = document.querySelector('#clear-filters');
  const count = document.querySelector('#result-count');
  const empty = document.querySelector('#no-results');
  const update = () => { const query = input.value.trim().toLowerCase(); let visible = 0; entries.forEach((entry) => { const tags = entry.dataset.tags.split('|'); const matches = entry.dataset.search.includes(query) && [...activeTags].every((tag) => tags.includes(tag.toLowerCase())); entry.hidden = !matches; if (matches) visible += 1; }); filters.forEach((filter) => filter.classList.toggle('is-active', activeTags.has(filter.dataset.filterTag))); count.textContent = query || activeTags.size ? `${visible} article${visible === 1 ? '' : 's'}` : ''; empty.hidden = visible !== 0; clear.hidden = activeTags.size === 0 && !query; };
  input?.addEventListener('input', update);
  filters.forEach((filter) => filter.addEventListener('click', () => { const tag = filter.dataset.filterTag; activeTags.has(tag) ? activeTags.delete(tag) : activeTags.add(tag); update(); }));
  clear?.addEventListener('click', () => { activeTags.clear(); input.value = ''; update(); });
</script></Base>}
{props.mode === 'history' && <Base title="History · Devy.hist" description="A chronological record of work and milestones."><header class="page-head"><p class="eyebrow">History</p><h1>Along the way.</h1><p class="intro">A chronological record of work, projects, and milestones.</p></header>{props.entries.length ? <div class="entry-list">{props.entries.map((entry: any) => <article class="list-item"><a href={`/history/${entry.id}/`}><p class="list-meta">{date(entry.data.pubDate)}</p><h2>{entry.data.title}</h2><p class="list-description">{entry.data.description}</p></a><div class="tag-row">{entry.data.tags.map((tag: string) => <span class={`tag ${tagClass(tag)}`}>{tag}</span>)}</div></article>)}</div> : <p class="empty">Nothing here yet.</p>}</Base>}
{props.mode === 'post' && <Base title={`${props.entry.data.title} · Devy.hist`} description={props.entry.data.description}><article class="post"><p class="eyebrow">{props.entry.data.kind === 'history' ? 'History' : 'Article'} · {date(props.entry.data.pubDate)}</p><h1>{props.entry.data.title}</h1><div class="tag-row post-meta">{props.entry.data.tags.map((tag: string) => <span class={`tag ${tagClass(tag)}`}>{tag}</span>)}</div><div class="prose"><Content /></div></article></Base>}
<style>.article-search{margin:-8px 0 26px;padding:18px 0 24px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.search-input{width:100%;padding:12px 0;border:0;border-bottom:1px solid var(--ink);border-radius:0;background:transparent;color:var(--ink);font:inherit;font-size:16px;outline:0}.search-input:focus{border-color:#2563eb}.filter-head{display:flex;justify-content:space-between;align-items:center;margin-top:20px;color:var(--muted);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.clear-filter{border:0;background:transparent;color:var(--muted);font:inherit;font-size:11px;text-decoration:underline;cursor:pointer}.tag-filter{cursor:pointer;transition:transform .12s,box-shadow .12s}.tag-filter:hover{transform:translateY(-1px)}.tag-filter.is-active{box-shadow:0 0 0 2px var(--ink)}.result-count{min-height:18px;margin:0 0 8px;color:var(--muted);font-size:12px}.article-item[hidden]{display:none}.post-meta{margin:20px 0 34px}</style>
