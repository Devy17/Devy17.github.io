---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const articles = (await getCollection('entries')).filter((entry) => !entry.data.draft && entry.data.kind === 'article').sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const tagClass = (tag: string) => 'tag-' + ([...tag].reduce((sum, char) => sum + char.charCodeAt(0), 0) % 5);
---
<Base title="Devy.hist" description="Personal technical notes and articles."><section class="hero"><h1>Still building.</h1><blockquote>“What does not kill me makes me stronger.” — Friedrich Nietzsche</blockquote></section><section class="latest"><p class="eyebrow">Latest Articles</p>{articles.length ? <div class="entry-list">{articles.slice(0,5).map((entry) => <article class="list-item"><a href={`/articles/${entry.id}/`}><p class="list-meta">{entry.data.pubDate.toLocaleDateString('en',{year:'numeric',month:'short',day:'numeric'})}</p><h2>{entry.data.title}</h2><p class="list-description">{entry.data.description}</p></a><div class="tag-row">{entry.data.tags.map((tag) => <span class={`tag ${tagClass(tag)}`}>{tag}</span>)}</div></article>)}</div> : <p class="empty">Articles will appear here.</p>}</section></Base>
<style>.hero{margin:auto 0;padding:112px 0 84px}.hero h1{font-size:clamp(54px,10vw,88px)}blockquote{margin:28px 0 0;color:var(--muted);font-size:12px;letter-spacing:.01em}.latest{padding-bottom:24px}</style>
