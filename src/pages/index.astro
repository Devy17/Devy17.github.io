---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const entries = (await getCollection('entries')).filter((entry) => !entry.data.draft).sort((a,b) => b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const href = (entry: any) => entry.data.series ? `/series/${entry.data.series.slug}/${entry.id}/` : entry.data.kind === 'history' ? `/history/${entry.id}/` : `/${entry.data.kind}s/${entry.id}/`;
---
<Base title="Devy.hist" description="Notes, briefings, series, and history."><section class="hero"><h1>Still building.</h1><blockquote>“What does not kill me makes me stronger.” — Friedrich Nietzsche</blockquote></section><section class="latest"><p class="eyebrow">Latest</p>{entries.length ? <div class="entry-list">{entries.slice(0,5).map((entry) => <a class="list-item" href={href(entry)}><p class="list-meta">{entry.data.pubDate.toLocaleDateString('en',{year:'numeric',month:'short',day:'numeric'})} · {entry.data.kind}</p><h2>{entry.data.title}</h2><p class="list-description">{entry.data.description}</p></a>)}</div> : <p class="empty">Notes will appear here.</p>}</section></Base>
<style>.hero{margin:auto 0;padding:112px 0 84px}.hero h1{font-size:clamp(54px,10vw,88px)}blockquote{margin:28px 0 0;color:var(--muted);font-size:12px;letter-spacing:.01em}.latest{padding-bottom:24px}</style>
